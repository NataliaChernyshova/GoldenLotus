  <!-- Скрипт галереи (лайтбокс) -->
  <script>
    const lightbox = document.getElementById('lightbox');
    const lightboxImg = document.getElementById('lightbox-img');
    const galleryImages = Array.from(document.querySelectorAll('.gallery img'));
    let currentIndex = 0;

    // Вешаем клик на каждую картинку галереи автоматически
    galleryImages.forEach((img, index) => {
      img.addEventListener('click', () => {
        currentIndex = index;
        updateImage();
        lightbox.showModal();
      });
    });

    function updateImage() {
      // Если используете отдельные большие фото, можно брать img.dataset.full || img.src
      lightboxImg.src = galleryImages[currentIndex].src;
    }

    function changeSlide(step) {
      currentIndex = (currentIndex + step + galleryImages.length) % galleryImages.length;
      updateImage();
    }

    function closeLightbox() {
      lightbox.close();
    }

    function closeOnBackdrop(event) {
      if (event.target === lightbox) {
        closeLightbox();
      }
    }

    // Переключение стрелками на клавиатуре (влево / вправо)
    document.addEventListener('keydown', (e) => {
      if (!lightbox.open) return;
      if (e.key === 'ArrowLeft') changeSlide(-1);
      if (e.key === 'ArrowRight') changeSlide(1);
    });
  </script>

